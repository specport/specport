{
  "name": "@specport/specport",
  "version": "0.1.0",
  "description": "Deterministic final-tree review coverage and contract scaffolding for AI-assisted code changes",
  "license": "MIT",
  "type": "module",
  "homepage": "https://stancsz.github.io/specport/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stancsz/specport.git"
  },
  "bugs": {
    "url": "https://github.com/stancsz/specport/issues"
  },
  "keywords": [
    "ai-coding",
    "code-review",
    "contracts",
    "git",
    "vibe-coding",
    "verification"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "specport": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "skills/**/*.md",
    "examples/**/*.json",
    "schemas/**/*.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs/promises').then(({rm}) => rm('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "npm run typecheck && npm run lint && npm run build && npm test",
    "prepack": "npm run verify:package"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "dependencies": {
    "assertion-error": "^2.0.1",
    "cac": "^6.7.14",
    "chai": "^5.3.3",
    "check-error": "^2.1.3",
    "debug": "^4.4.3",
    "deep-eql": "^5.0.2",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.1",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fdir": "^6.5.0",
    "js-tokens": "^9.0.1",
    "loupe": "^3.2.1",
    "magic-string": "^0.30.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.16",
    "pathe": "^2.0.3",
    "pathval": "^2.0.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.25",
    "rollup": "^4.62.4",
    "siginfo": "^2.0.0",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "strip-literal": "^3.1.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.17",
    "tinypool": "^1.1.1",
    "tinyrainbow": "^2.0.0",
    "tinyspy": "^4.0.4",
    "undici-types": "^7.18.2",
    "vite": "^7.3.6",
    "vite-node": "^3.2.4",
    "why-is-node-running": "^2.3.0"
  },
  "author": ""
}
