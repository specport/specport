{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specport.dev/schemas/product-contract.schema.json",
  "title": "SpecPort Product Contract",
  "type": "object",
  "required": [
    "contractVersion",
    "kind",
    "id",
    "title",
    "provenance",
    "intent",
    "constraints",
    "acceptance",
    "verification",
    "taste",
    "release"
  ],
  "properties": {
    "contractVersion": { "type": "string", "minLength": 1 },
    "kind": { "const": "product-contract" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "required": ["source", "license", "owner"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "intent": {
      "type": "object",
      "required": ["owner", "userJob", "outcome", "nonGoals"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "userJob": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "nonGoals": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "risk": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command", "purpose"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "environment": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "taste": {
      "type": "object",
      "required": ["required", "reviewer", "rubric"],
      "properties": {
        "required": { "type": "boolean" },
        "reviewer": { "type": "string" },
        "rubric": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "required": [
        "target",
        "version",
        "compatibility",
        "security",
        "observability",
        "shipAuthority",
        "readiness",
        "rollback"
      ],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "compatibility": { "type": "string", "minLength": 1 },
        "security": { "type": "string", "minLength": 1 },
        "observability": { "type": "string", "minLength": 1 },
        "shipAuthority": { "type": "string", "minLength": 1 },
        "readiness": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rollback": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "boundaries": {
      "type": "object",
      "properties": {
        "allowedPaths": { "type": "array", "items": { "type": "string" } },
        "forbiddenPaths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
